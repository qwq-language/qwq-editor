{
  "name": "qwq-editor",
  "version": "0.2.1",
  "description": "qwq language code editor",
  "author": "qwq-language",
  "license": "MIT",
  "homepage": "https://github.com/qwq-language/qwq-editor",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:wasm": "node scripts/ensure-wasm.cjs full",
    "build:wasm:source": "node scripts/run-platform-script.cjs build-wasm",
    "build:analysis-wasm": "node scripts/ensure-wasm.cjs analysis",
    "build:analysis-wasm:source": "cross-env QWQ_ANALYZE_ONLY=1 QWQ_WASM_OUTPUT_DIR=src/wasm-analysis node scripts/run-platform-script.cjs build-wasm",
    "predev": "node scripts/run-platform-script.cjs predev",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:wasm && vite build",
    "build:electron": "npm run build:analysis-wasm && vite build --mode electron && electron-builder --publish never",
    "build:pages": "npm run build:wasm && vite build --mode pages",
    "preelectron:dev": "npm run build:analysis-wasm",
    "electron:dev": "node scripts/electron-dev.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "wasm:version": "node scripts/wasm-version.cjs",
    "pack:release": "node scripts/pack-release.cjs",
    "release:assets": "node scripts/release-assets.cjs"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "7zip-bin": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "monaco-editor": "^0.57.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "dev.qwq.editor",
    "productName": "qwq-editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/app-icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/app-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/app-icon.png",
      "category": "Development",
      "maintainer": "qwq-language",
      "synopsis": "qwq language code editor",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "qwq-editor",
      "installerIcon": "public/app-icon.ico",
      "uninstallerIcon": "public/app-icon.ico",
      "installerHeaderIcon": "public/app-icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "desktopName": "qwq-editor"
}
